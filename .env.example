# API keys. Paste each key after the = sign (no spaces, no quotes).
# Leave a line as it is if you don't use that service.

# Voice recognition (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Cloud backup brain. Default is Z.ai GLM: https://z.ai  (API Keys page)
ZAI_API_KEY=paste-your-key-here

# Other cloud brains you can switch to in settings.json ("cloud_brain")
DASHSCOPE_API_KEY=paste-your-key-here
DEEPSEEK_API_KEY=paste-your-key-here
