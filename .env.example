# API keys. Paste each key after the = sign (no spaces, no quotes).
# Leave a line as it is if you don't use that service.

# Gemini: the default main AI and voice recognition (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# Other AIs you can choose as main or backup (tray menu / popup):
# Z.ai GLM (cheap): https://z.ai  (API Keys page)
ZAI_API_KEY=paste-your-key-here
# Alibaba Qwen
DASHSCOPE_API_KEY=paste-your-key-here
# DeepSeek
DEEPSEEK_API_KEY=paste-your-key-here
# OpenRouter: one key for many AIs (GPT, Claude, Gemini, Qwen...): https://openrouter.ai
OPENROUTER_API_KEY=paste-your-key-here
